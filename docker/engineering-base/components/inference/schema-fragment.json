{
  "$id": "https://nga.local/schema/native-full-label-v1.json",
  "title": "Native frozen full-label inference component",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter",
    "runtime",
    "model",
    "dataset",
    "max_length",
    "batch_size"
  ],
  "properties": {
    "adapter": {
      "const": "native-full-label-v1"
    },
    "runtime": {
      "const": "npu"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "manifest",
        "manifest_sha256"
      ],
      "properties": {
        "id": {
          "enum": [
            "Qwen3.5-0.8B-Base",
            "Qwen3.5-2B-Base",
            "Qwen3.5-4B-Base"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "manifest": {
          "type": "string",
          "pattern": "^/"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "count"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "max_length": {
      "const": 8192
    },
    "batch_size": {
      "const": 1
    }
  }
}

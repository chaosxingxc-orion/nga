{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nga-unified-config-v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "adapter",
        "runtime"
      ],
      "properties": {
        "schema": {
          "const": "nga-unified-config-v1"
        },
        "adapter": {
          "const": "environment-check-v1"
        },
        "runtime": {
          "const": "cpu"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "adapter",
        "runtime",
        "manifest",
        "manifest_sha256",
        "output",
        "workers",
        "chunk_size"
      ],
      "properties": {
        "schema": {
          "const": "nga-unified-config-v1"
        },
        "adapter": {
          "const": "native-panel-score-v1"
        },
        "runtime": {
          "const": "cpu"
        },
        "manifest": {
          "type": "string",
          "pattern": "^/"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "output": {
          "type": "string",
          "pattern": "^/"
        },
        "workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "chunk_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      }
    },
    {
      "title": "Native frozen full-label inference component",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "runtime",
        "model",
        "dataset",
        "max_length",
        "batch_size",
        "schema",
        "output"
      ],
      "properties": {
        "adapter": {
          "const": "native-full-label-v1"
        },
        "runtime": {
          "const": "npu"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "path",
            "manifest",
            "manifest_sha256"
          ],
          "properties": {
            "id": {
              "enum": [
                "Qwen3.5-0.8B-Base",
                "Qwen3.5-2B-Base",
                "Qwen3.5-4B-Base"
              ]
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "manifest": {
              "type": "string",
              "pattern": "^/"
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "dataset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "count"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "max_length": {
          "const": 8192
        },
        "batch_size": {
          "const": 1
        },
        "schema": {
          "const": "nga-unified-config-v1"
        },
        "output": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    {
      "title": "Registered LoRA K1 training component",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "owner",
        "seed",
        "model",
        "dataset",
        "resume",
        "schema",
        "output"
      ],
      "properties": {
        "adapter": {
          "const": "k1-full-train-v1"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "path",
            "manifest",
            "manifest_sha256"
          ],
          "properties": {
            "id": {
              "const": "Qwen3.5-0.8B-Base"
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "manifest": {
              "type": "string",
              "pattern": "^/"
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "dataset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "path",
            "manifest",
            "manifest_sha256"
          ],
          "properties": {
            "id": {
              "const": "decision-v7-train"
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "manifest": {
              "type": "string",
              "pattern": "^/"
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "resume": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "schema": {
          "const": "nga-unified-config-v1"
        },
        "output": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    {
      "title": "CPU panel export (rejects unbound v1 inference)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "adapter",
        "runtime",
        "source",
        "owner_sha256",
        "inference_identity_sha256",
        "source_config",
        "source_config_sha256",
        "model_inventory_sha256",
        "panel_manifest",
        "panel_manifest_sha256",
        "output"
      ],
      "properties": {
        "schema": {
          "const": "nga-unified-config-v1"
        },
        "adapter": {
          "const": "native-panel-export-v1"
        },
        "runtime": {
          "const": "cpu"
        },
        "source": {
          "type": "string",
          "pattern": "^/"
        },
        "owner_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inference_identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_config": {
          "type": "string",
          "pattern": "^/"
        },
        "source_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_inventory_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "panel_manifest": {
          "type": "string",
          "pattern": "^/"
        },
        "panel_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "output": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    {
      "title": "Prospectively bound native inference",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "runtime",
        "model",
        "dataset",
        "max_length",
        "batch_size",
        "schema",
        "output",
        "panel",
        "image_sha256"
      ],
      "properties": {
        "adapter": {
          "const": "native-full-label-v2"
        },
        "runtime": {
          "const": "npu"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "path",
            "manifest",
            "manifest_sha256"
          ],
          "properties": {
            "id": {
              "enum": [
                "Qwen3.5-0.8B-Base",
                "Qwen3.5-2B-Base",
                "Qwen3.5-4B-Base"
              ]
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "manifest": {
              "type": "string",
              "pattern": "^/"
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "dataset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "count"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "max_length": {
          "const": 8192
        },
        "batch_size": {
          "const": 1
        },
        "schema": {
          "const": "nga-unified-config-v1"
        },
        "output": {
          "type": "string",
          "pattern": "^/"
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "panel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract",
            "contract_file_sha256",
            "contract_sha256",
            "ordered_requests_sha256",
            "model_sha256"
          ],
          "properties": {
            "contract": {
              "type": "string",
              "pattern": "^/"
            },
            "contract_file_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "contract_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "ordered_requests_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "model_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    {
      "title": "Prospective panel export",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "adapter",
        "runtime",
        "source",
        "owner_sha256",
        "source_config",
        "source_config_sha256",
        "panel_manifest",
        "panel_manifest_sha256",
        "output"
      ],
      "properties": {
        "schema": {
          "const": "nga-unified-config-v1"
        },
        "adapter": {
          "const": "native-panel-export-v2"
        },
        "runtime": {
          "const": "cpu"
        },
        "source": {
          "type": "string",
          "pattern": "^/"
        },
        "owner_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_config": {
          "type": "string",
          "pattern": "^/"
        },
        "source_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "panel_manifest": {
          "type": "string",
          "pattern": "^/"
        },
        "panel_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "output": {
          "type": "string",
          "pattern": "^/"
        }
      }
    }
  ]
}

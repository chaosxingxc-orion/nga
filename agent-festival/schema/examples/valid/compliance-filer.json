{
  "contract_version": "0.1.0",
  "subject": { "id": "compliance-filer", "version": "0.9.2" },
  "provides": [
    { "skill_id": "file-regulatory-report", "description": "Assemble and submit a regulatory filing" }
  ],
  "requires": [
    {
      "resource": { "kind": "agent", "selector": "doc-extractor" },
      "actions": ["delegate"],
      "effect": "none",
      "purpose": "field extraction is delegated; the caller must be able to grant doc-extractor's own requires transitively"
    },
    {
      "resource": { "kind": "data", "selector": "s3://tenant-{tenant}/inbox/*.pdf" },
      "actions": ["read"],
      "effect": "none",
      "supplied_by": "upstream"
    },
    {
      "resource": { "kind": "network", "selector": "filings.regulator.gov" },
      "actions": ["write"],
      "effect": "irreversible",
      "purpose": "submit filing"
    },
    {
      "resource": { "kind": "secret", "selector": "regulator-api-key" },
      "actions": ["read"],
      "effect": "none"
    }
  ],
  "effects": { "level": "irreversible", "compensation": "manual" },
  "bounds": { "max_cost": { "amount": 2, "unit": "USD" }, "max_seconds": 600, "max_downstream_calls": 3 }
}
